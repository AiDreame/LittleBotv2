{
  "name": "salesrecon",
  "private": true,
  "description": "LittleBot — Discord bot for reconciling sales team self-reported numbers against platform data",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "dev:bot": "pnpm --filter @salesrecon/bot dev",
